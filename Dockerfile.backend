FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
# Enable Keras 2 legacy deserialization compatibility
ENV TF_USE_LEGACY_KERAS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "tensorflow<2.16.0" "tf-keras" fastapi uvicorn pydantic python-multipart scikit-learn numpy pandas shap lime streamlit bcrypt pyjwt passlib cryptography && \
    (test -f requirements.txt && pip install --no-cache-dir -r requirements.txt || true)

COPY . .

EXPOSE 8000

CMD ["python", "api.py"]