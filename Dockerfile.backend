FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir tensorflow fastapi "uvicorn[standard]" pydantic python-multipart scikit-learn numpy pandas shap lime streamlit bcrypt pyjwt passlib cryptography && \
    (test -f requirements.txt && pip install --no-cache-dir -r requirements.txt || true)

COPY . .

EXPOSE 8000

# Start FastAPI persistently with Uvicorn on port 8000
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]